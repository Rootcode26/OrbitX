NODE_ENV=development
PORT=5000
POSTGRES_USER=your_db_user
POSTGRES_PASSWORD=your_db_password
POSTGRES_HOST=your_db_host
POSTGRES_DB=your_db_name
POSTGRES_PORT=your_db_port
PINO_LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://100.68.65.0:3000
CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key
DATABASE_URL=your_db_url
CELESTRAK_SATCAT_URL=https://celestrak.org/satcat/records.php?GROUP=ACTIVE&FORMAT=JSON
CELESTRAK_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=ACTIVE&FORMAT=TLE
CELESTRAK_GROUPS=ACTIVE,FENGYUN-1C-DEBRIS,IRIDIUM-33-DEBRIS,COSMOS-2251-DEBRIS
CELESTRAK_USER_AGENT=OrbitX/1.0
CELESTRAK_SYNC_CRON=0 */2 * * *
SGP4_PROPAGATION_CRON=*/5 * * * *
PROPAGATION_URL=http://localhost:8000/propagation
SATELLITE_CURRENT_STATE_URL=http://localhost:8000/api/satellite-state/current
PROPAGATION_REQUEST_TIMEOUT_MS=30000
CONJUNCTION_CHECK_URL=http://localhost:8000/api/conjunctions/check
CONJUNCTION_SCREEN_URL=http://localhost:8000/api/conjunctions/screen
CONJUNCTION_REQUEST_TIMEOUT_MS=30000
CELESTRAK_REQUEST_TIMEOUT_MS=120000
