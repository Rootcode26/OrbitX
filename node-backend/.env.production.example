# ─── OrbitX node-backend — PRODUCTION env template ───
# Set these in Railway → node-backend service → Variables.
# Do NOT commit real values.

NODE_ENV=production
# Railway injects PORT automatically; leave unset or set to 5000
PORT=5000
PINO_LOG_LEVEL=info

# Postgres — use Railway Postgres connection string (or your managed DB).
# DATABASE_URL is what the app actually connects with.
DATABASE_URL=postgresql://user:password@host:5432/dbname
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_DB=
POSTGRES_PORT=5432

# CORS — MUST be your deployed frontend origin(s), comma-separated, no trailing slash
CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# Clerk — use PRODUCTION instance keys (pk_live_ / sk_live_)
CLERK_PUBLISHABLE_KEY=pk_live_xxx
CLERK_SECRET_KEY=sk_live_xxx

# Python scientific service — deployed pythonbackend URL (Railway internal or public)
PROPAGATION_URL=https://your-python-backend.up.railway.app/propagation
SATELLITE_CURRENT_STATE_URL=https://your-python-backend.up.railway.app/api/satellite-state/current
CONJUNCTION_CHECK_URL=https://your-python-backend.up.railway.app/api/conjunctions/check
CONJUNCTION_SCREEN_URL=https://your-python-backend.up.railway.app/api/conjunctions/screen

# Celestrak data source (defaults are fine)
CELESTRAK_SATCAT_URL=https://celestrak.org/satcat/records.php?GROUP=ACTIVE&FORMAT=JSON
CELESTRAK_TLE_URL=https://celestrak.org/NORAD/elements/gp.php?GROUP=ACTIVE&FORMAT=TLE
CELESTRAK_GROUPS=ACTIVE,FENGYUN-1C-DEBRIS,IRIDIUM-33-DEBRIS,COSMOS-2251-DEBRIS
CELESTRAK_USER_AGENT=OrbitX/1.0

# Cron schedules
CELESTRAK_SYNC_CRON=0 */2 * * *
SGP4_PROPAGATION_CRON=*/5 * * * *

# Timeouts (ms)
PROPAGATION_REQUEST_TIMEOUT_MS=30000
CONJUNCTION_REQUEST_TIMEOUT_MS=30000
CELESTRAK_REQUEST_TIMEOUT_MS=120000
