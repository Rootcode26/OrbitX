{
  "name": "node-backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "migrate:create": "node-pg-migrate create --migrations-dir src/db/migrations --migration-file-language ts --envPath .env",
    "migrate:up": "node-pg-migrate up --migrations-dir src/db/migrations --envPath .env",
    "migrate:down": "node-pg-migrate down --migrations-dir src/db/migrations --envPath .env",
    "migrate:redo": "node-pg-migrate redo --migrations-dir src/db/migrations --envPath .env",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.1.1",
      "onFail": "download"
    }
  },
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@clerk/express": "^2.1.63",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  }
}
