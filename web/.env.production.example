# ─── OrbitX web (Next.js) — PRODUCTION env template ───
# Set these in Vercel → Project → Settings → Environment Variables.
# NEXT_PUBLIC_* values are exposed to the browser (safe: publishable key only).

# Deployed node-backend URL + /api/v1 path
NEXT_PUBLIC_API_BASE_URL=https://your-node-backend.up.railway.app/api/v1

# Clerk PRODUCTION publishable key (pk_live_)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
